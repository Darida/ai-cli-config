{
  "block-git-branch-changes": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.gemini/hooks/bash-guard/block-git-branch-changes.sh"
          }
        ]
      }
    ]
  },
  "question-readonly-note": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.gemini/hooks/prompt-guard/question-readonly-note.sh"
          }
        ]
      }
    ]
  }
}
