# Track everything by default; only exclude local/vendored/generated
# content below.

# Claude Code local, machine-specific overrides — never shared.
.claude/settings.local.json

# Python bytecode cache.
**/__pycache__/

# Docs pulled down by the antigravity CLI itself, not authored content.
.gemini/antigravity-cli/docs/

# Generated npm dependencies inside image-gen.
image-gen/node_modules/

# Single-person workspace, no CI reinstalling from scratch — lockfile
# reproducibility across contributors/machines isn't needed here.
**/package-lock.json
