#!/bin/bash
# Skips gracefully rather than failing when the given repo isn't a Go
# module — this gets called unconditionally for every repo, most of which
# aren't Go.
set -e

run_timed() {
    local label="$1"
    shift
    local start=$EPOCHREALTIME
    local failed=
    local output
    output="$("$@" 2>&1)" || failed=1
    echo "⏱️  go test $label took $(awk "BEGIN { printf \"%.1fs\", $EPOCHREALTIME - $start }")"
    if [ -n "$failed" ]; then
        echo "$output"
        echo ""
        echo "❌ Tests failed! Push aborted."
        echo "Fix the failing tests and try again."
        exit 1
    fi
}

for arg in "$@"; do
    case "$arg" in
        --repo=*) REPO="${arg#--repo=}" ;;
        *) echo "❌ go-test: unknown argument: $arg" >&2; exit 1 ;;
    esac
done
if [ -z "${REPO:-}" ]; then
    echo "❌ go-test: usage: go-test --repo=<path>" >&2
    exit 1
fi

if [ ! -f "$REPO/go.mod" ]; then
    echo "⏭️ No go.mod found. Skipping Go tests for this repository."
    exit 0
fi

echo "🧪 go test ./..."
# A no-test pass first compiles and links every test binary, so the real
# pass afterward hits the build cache and its time is test execution only.
run_timed build go -C "$REPO" test -run '^$' ./... -timeout 30s
run_timed test go -C "$REPO" test ./... -timeout 30s
echo "✓ Go tests passed"
