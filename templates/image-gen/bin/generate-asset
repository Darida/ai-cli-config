#!/bin/bash
# Thin shim, same pattern as ../../git/hooks/push-all: resolve this
# script's own real location (so it works called via a symlink or a
# relative path from anywhere).
#
# vite-node needs the real process cwd to actually be this package's own
# directory to resolve its dependencies correctly (confirmed empirically —
# without this, native deps like sharp fail to load at all; passing --root
# instead of actually `cd`-ing is not enough, and --root also has its own
# problem: vite-node's --script mode only strips the literal "--script"
# flag and the script path from argv when reconstructing it for the
# script's own process.argv, so any other vite-node flag like --root leaks
# straight through into the script's own arguments). generate-asset.ts
# itself takes no relative paths at all (--assets-dir must be absolute —
# the caller resolves it before invoking this), so the only reason this
# still captures $PWD below is for this shim's own git lookup, not to
# bridge anything into the .ts process.
#
# This shim is the only thing in this package that knows about git at
# all: it resolves the OpenRouter API key from `git config
# openrouter.imagenapikey`, read in whichever repo the caller's directory
# is actually inside (git itself walks up from there to find the nearest
# .git — could be the calling project's own repo, could be an outer
# workspace root, whatever that directory's git considers "the repo").
# generate-asset.ts itself has no git/config knowledge — it just takes
# --key=<value> as a plain CLI flag and uses it as-is; run it directly
# (bypassing this shim) to supply a key any other way.
#
# Lives in bin/, one level below the package itself, so its own filename
# ("generate-asset") can never collide with generate-asset.ts's own module
# specifier — an earlier version of this shim sat directly next to the
# .ts files and shadowed them: Node/Vite's extensionless import
# resolution matched the shim script itself before the .ts file with the
# same base name, producing confusing failures (up to and including
# trying to parse the bash script as JavaScript).
set -euo pipefail
BIN_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
PKG_DIR="$(cd "$BIN_DIR/.." && pwd)"
CALLER_CWD="$PWD"

API_KEY="$(git -C "$CALLER_CWD" config --get openrouter.imagenapikey 2>/dev/null || true)"
if [ -z "$API_KEY" ]; then
    echo "git config openrouter.imagenapikey is not set in the git repo containing $CALLER_CWD." >&2
    echo "Run this from inside the repo that has it configured, or set it here:" >&2
    echo "  git config --local openrouter.imagenapikey 'YOUR_KEY_HERE'" >&2
    exit 1
fi

cd "$PKG_DIR"
exec "$PKG_DIR/node_modules/.bin/vite-node" --script "$PKG_DIR/generate-asset.ts" --key="$API_KEY" "$@"
