#!/bin/bash
# Skips gracefully rather than failing when the given repo has no
# package.json — this gets called unconditionally for every repo, most of
# which aren't Node projects.
set -e

for arg in "$@"; do
    case "$arg" in
        --repo=*) REPO="${arg#--repo=}" ;;
        *) echo "❌ npm-test: unknown argument: $arg" >&2; exit 1 ;;
    esac
done
if [ -z "${REPO:-}" ]; then
    echo "❌ npm-test: usage: npm-test --repo=<path>" >&2
    exit 1
fi

if [ ! -f "$REPO/package.json" ]; then
    echo "⏭️ No package.json found. Skipping npm tests for this repository."
    exit 0
fi

echo "🧪 npm test"
if ! npm --prefix "$REPO" test; then
    echo ""
    echo "❌ Tests failed! Push aborted."
    echo "Fix the failing tests and try again."
    exit 1
fi
