#!/bin/bash
# Safety net for the case pre-commit's go-generate didn't run or didn't
# catch drift (different toolchain, --no-verify, etc.): regenerate again
# right before push, and if that changes anything, commit it automatically
# — same reasoning as cassette-check auto-committing expected test noise
# instead of just failing the push on it. Skips gracefully if the repo
# isn't a Go module.
set -e

for arg in "$@"; do
    case "$arg" in
        --repo=*) REPO="${arg#--repo=}" ;;
        --generated-dir=*) GEN_DIR="${arg#--generated-dir=}" ;;
        *) echo "❌ go-generate-check: unknown argument: $arg" >&2; exit 1 ;;
    esac
done
if [ -z "${REPO:-}" ] || [ -z "${GEN_DIR:-}" ]; then
    echo "❌ go-generate-check: usage: go-generate-check --repo=<path> --generated-dir=<relative>" >&2
    exit 1
fi

if [ ! -f "$REPO/go.mod" ]; then
    echo "⏭️ No go.mod found. Skipping go generate check for this repository."
    exit 0
fi

echo "🧪 go generate ./..."
if ! go -C "$REPO" generate ./...; then
    echo "❌ go generate failed! Push aborted."
    exit 1
fi

CHANGES=$(git -C "$REPO" status --short -- "$GEN_DIR")
if [ -z "$CHANGES" ]; then
    echo "✓ $GEN_DIR is up to date"
    exit 0
fi

echo "⚠️  $GEN_DIR drifted from source — committing automatically..."
git -C "$REPO" add "$GEN_DIR"
git -C "$REPO" commit -m "chore: regenerate $GEN_DIR from pre-push check

Co-Authored-By: Claude Haiku 4.5 <noreply@anthropic.com>"
echo "✓ $GEN_DIR committed"
