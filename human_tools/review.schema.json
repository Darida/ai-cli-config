{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": ["LGTM", "ACTION_REQUIRED"]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule": {
            "type": "string",
            "description": "Rule name (e.g. Rule 1: Review Comments)"
          },
          "text": {
            "type": "string",
            "description": "Actionable finding description and specific file locations"
          }
        },
        "required": ["rule", "text"],
        "additionalProperties": false
      }
    }
  },
  "required": ["status", "notes"],
  "additionalProperties": false
}
